generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  balance         BigInt           @default(0) @db.BigInt
  version         Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentRequests PaymentRequest[]
  transactions    Transaction[]

  @@map("users")
}

enum PaymentRequestStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FailureType {
  BUSINESS
  TECHNICAL
}

model PaymentRequest {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  amount              BigInt               @db.BigInt
  reference           String
  description         String?
  status              PaymentRequestStatus @default(PENDING)
  idempotencyKey      String               @unique
  failureReason       String?
  failureType         FailureType?
  retryCount          Int                  @default(0)
  maxAttempts         Int                  @default(3)
  nextRetryAt         DateTime?
  queuedAt            DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions        Transaction[]
  events              PaymentEvent[]

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([reference])
  @@index([createdAt])
  @@map("payment_requests")
}

enum TransactionType {
  DEBIT
  CREDIT
}

model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  paymentRequestId String?         @db.Uuid
  amount           BigInt          @db.BigInt
  reference        String
  type             TransactionType
  balanceAfter     BigInt?         @db.BigInt
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  @@unique([paymentRequestId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

enum PaymentEventType {
  CREATED
  QUEUED
  PROCESSING_STARTED
  SUCCEEDED
  FAILED
  RETRY_TRIGGERED
}

model PaymentEvent {
  id               String               @id @default(uuid()) @db.Uuid
  paymentRequestId String               @db.Uuid
  eventType        PaymentEventType
  previousStatus   PaymentRequestStatus?
  newStatus        PaymentRequestStatus?
  attemptNumber    Int?
  metadata         Json?
  createdAt        DateTime             @default(now())
  paymentRequest   PaymentRequest       @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId, createdAt])
  @@map("payment_events")
}
