APP_ID=credit-flow
APP_PORT=3000
APP_SWAGGER_ENABLED=true
APP_SWAGGER_PATH=docs
WORKER_PORT=3001
WORKER_ID=worker-1
NODE_ENV=development
LOG_LEVEL=info
