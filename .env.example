APP_ID=credit-flow
APP_PORT=3000
WORKER_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SIMULATION_MAX_AMOUNT=1000000
# Optional deterministic seed for simulation tests
# PAYMENT_SIMULATION_SEED=test-seed
DATABASE_URL=postgresql://credit_flow:credit_flow@localhost:5432/credit_flow
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://credit_flow:credit_flow@localhost:5672
