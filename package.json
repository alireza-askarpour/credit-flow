{
  "name": "credit-flow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nest build",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start:api": "nest start api",
    "start:worker": "nest start worker",
    "start:dev:api": "nest start api --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:prod:api": "node dist/apps/api/main.js",
    "start:prod:worker": "node dist/apps/worker/main.js",
    "start:debug:api": "nest start api --debug 9229 --watch",
    "start:debug:worker": "nest start worker --debug 9230 --watch",
    "prisma:generate": "prisma generate --schema libs/prisma/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema libs/prisma/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema libs/prisma/prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate --schema libs/prisma/prisma/schema.prisma",
    "prisma:format": "prisma format --schema libs/prisma/prisma/schema.prisma",
    "test": "jest --runInBand"
  },
  "prisma": {
    "seed": "node libs/prisma/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.16.2",
    "amqplib": "^0.10.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
